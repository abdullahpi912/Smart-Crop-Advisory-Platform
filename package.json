{
  "name": "cropling",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "concurrently --kill-others-on-fail -n \"BACKEND,FRONTEND\" -c \"yellow,cyan\" \"npm run start:backend\" \"npm run start:frontend\"",
    "dev": "npm start",
    "start:backend": "cd Backend && .venv\\Scripts\\python.exe app.py",
    "start:frontend": "cd Frontend && npm run dev"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
