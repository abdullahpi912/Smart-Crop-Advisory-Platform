# =========================================================================
# AgriSense Backend Environment Configuration Example
# Copy this file to .env and configure for your local or production environment.
# =========================================================================

# Database Configuration (Local MySQL or Managed Cloud like Aiven)
DB_HOST=localhost
DB_PORT=3306
DB_USER=agrisense_app
DB_PASSWORD=changeme
DB_NAME=agrisense_db
DB_POOL_SIZE=5

# Optional Database SSL (Tested with Aiven MySQL)
# - For Local MySQL: Leave DB_SSL_CA unset (or set DB_SSL_DISABLED=true if needed)
# - For Aiven Cloud MySQL: Aiven connects over TLS automatically even without DB_SSL_CA.
#   To enforce strict CA verification, set DB_SSL_CA=./certs/ca.pem (relative to Backend/ or repository root).
# DB_SSL_CA=./certs/ca.pem
# DB_SSL_DISABLED=false

# Flask Session Security Key
# Generate a strong 64-char key using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-32-byte-hex-secret

# Application Environment (development / production)
FLASK_ENV=production
FLASK_DEBUG=False

# Allowed Frontend Origins for CORS (comma-separated if multiple)
FRONTEND_URL=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
